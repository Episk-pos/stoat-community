# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
config.define_string('backend_path')
config.define_string('frontend_path')
config.define_string('flutter_path')
config.define_bool('prebuilt')
config.define_bool('compose')
config.define_bool('knowledge-browser')
config.define_bool('discord-stoat-sync')
config.define_bool('activity-sim')
config.define_bool('e2e-tests')
cfg = config.parse()

BACKEND = cfg.get('backend_path', os.path.join(os.getcwd(), '../../stoat-backend'))
FRONTEND = cfg.get('frontend_path', os.path.join(os.getcwd(), '../../stoat-frontend'))
FLUTTER = cfg.get('flutter_path', os.path.join(os.getcwd(), '../../stoat-flutter'))
DOCKER_DIR = os.path.join(os.getcwd(), 'docker')
SIBLING_DIR = os.path.join(os.getcwd(), '../..')
PREBUILT = cfg.get('prebuilt', False)
COMPOSE = cfg.get('compose', False)

REPOS = {
    'backend': {
        'path': BACKEND,
        'clone_url': 'https://github.com/episk-pos/stoat-backend.git',
        'dir_name': 'stoat-backend',
    },
    'frontend': {
        'path': FRONTEND,
        'clone_url': 'https://github.com/episk-pos/stoat-frontend.git',
        'dir_name': 'stoat-frontend',
    },
    'flutter': {
        'path': FLUTTER,
        'clone_url': 'https://work.episkopos.community/episkopos/stoat-flutter.git',
        'dir_name': 'stoat-flutter',
    },
}

# ---------------------------------------------------------------------------
# Repo detection — check for sibling repos, offer clone buttons if missing
# ---------------------------------------------------------------------------
has_backend = os.path.exists(os.path.join(BACKEND, 'Cargo.toml'))
has_frontend = os.path.exists(os.path.join(FRONTEND, 'package.json'))
has_flutter = os.path.exists(os.path.join(FLUTTER, 'pubspec.yaml'))

REPO_DETECTION = {'backend': has_backend, 'frontend': has_frontend, 'flutter': has_flutter}

for name, repo in REPOS.items():
    present = REPO_DETECTION.get(name, False)
    if not present:
        warn('stoat-%s not found at %s — use the "Clone stoat-%s" button in the Tilt UI to clone it.' % (name, repo['path'], name))
        local_resource(
            'clone-stoat-%s' % name,
            cmd='echo "stoat-%s is not cloned yet. Click the Clone button to set it up."' % name,
            labels=['setup'],
        )

if COMPOSE:
    # -----------------------------------------------------------------------
    # Docker Compose mode
    # -----------------------------------------------------------------------
    docker_compose(os.path.join(os.getcwd(), 'docker-compose.yml'))

    # Label infrastructure services
    dc_resource('redis', labels=['infra'])
    dc_resource('mongodb', labels=['infra'])
    dc_resource('rabbitmq', labels=['infra'])
    dc_resource('maildev', labels=['infra'])
    dc_resource('minio', labels=['infra'])
    dc_resource('minio-init', labels=['infra'])

    # Backend services (only if backend available)
    if has_backend or PREBUILT:
        if not PREBUILT:
            # Build backend binaries and stage into docker/ for compose build
            SERVICES = {
                'delta':   {'crate': 'revolt-delta',   'binary': 'revolt-delta'},
                'bonfire': {'crate': 'revolt-bonfire',  'binary': 'revolt-bonfire'},
                'autumn':  {'crate': 'revolt-autumn',   'binary': 'revolt-autumn'},
                'january': {'crate': 'revolt-january',  'binary': 'revolt-january'},
            }

            local_resource(
                'backend-build',
                cmd='cd %s && cargo build --release %s && %s' % (
                    BACKEND,
                    ' '.join(['-p %s' % svc['crate'] for svc in SERVICES.values()]),
                    ' && '.join(['cp %s/target/release/%s %s/' % (BACKEND, svc['binary'], DOCKER_DIR) for svc in SERVICES.values()]),
                ),
                deps=[os.path.join(BACKEND, 'crates')],
                labels=['build'],
            )

        dc_resource('delta', labels=['services'])
        dc_resource('bonfire', labels=['services'])
        dc_resource('autumn', labels=['services'])
        dc_resource('january', labels=['services'])
        dc_resource('seed', labels=['seed'])

else:
    # -----------------------------------------------------------------------
    # Kubernetes mode (default)
    # -----------------------------------------------------------------------
    allow_k8s_contexts(['kind-stoat'])

    # -------------------------------------------------------------------
    # Namespace + Config
    # -------------------------------------------------------------------
    k8s_yaml('k8s/namespace.yaml')
    k8s_yaml('k8s/config.yaml')

    # -------------------------------------------------------------------
    # Infrastructure (always deployed — useful even without app repos)
    # -------------------------------------------------------------------
    k8s_yaml('k8s/infra/redis.yaml')
    k8s_yaml('k8s/infra/mongodb.yaml')
    k8s_yaml('k8s/infra/minio.yaml')
    k8s_yaml('k8s/infra/rabbitmq.yaml')
    k8s_yaml('k8s/infra/maildev.yaml')

    k8s_resource('redis', labels=['infra'])
    k8s_resource('mongodb', labels=['infra'],
                 port_forwards=['14717:27017'])
    k8s_resource('minio', labels=['infra'],
                 port_forwards=['14009:9000'])
    k8s_resource('minio-init', labels=['infra'],
                 resource_deps=['minio'])
    k8s_resource('rabbitmq', labels=['infra'],
                 port_forwards=['14672:15672'])
    k8s_resource('maildev', labels=['infra'],
                 port_forwards=['14080:8080'])

    # -------------------------------------------------------------------
    # Backend services — host-built binaries + thin Docker images
    # -------------------------------------------------------------------
    if has_backend or PREBUILT:
        SERVICES = {
            'delta':   {'crate': 'revolt-delta',   'binary': 'revolt-delta'},
            'bonfire': {'crate': 'revolt-bonfire',  'binary': 'revolt-bonfire'},
            'autumn':  {'crate': 'revolt-autumn',   'binary': 'revolt-autumn'},
            'january': {'crate': 'revolt-january',  'binary': 'revolt-january'},
        }

        if not PREBUILT:
            # Single cargo build for all backend crates (avoids Cargo lock contention)
            local_resource(
                'backend-build',
                cmd='cd %s && cargo build --release %s' % (
                    BACKEND,
                    ' '.join(['-p %s' % svc['crate'] for svc in SERVICES.values()]),
                ),
                deps=[os.path.join(BACKEND, 'crates')],
                labels=['build'],
            )

            for name, svc in SERVICES.items():
                image_tag = 'stoat-%s:dev' % name
                dockerfile = os.path.join(DOCKER_DIR, 'Dockerfile.%s' % name)

                # Build thin Docker image via staging dir (avoids backend .dockerignore)
                local_resource(
                    '%s-image' % name,
                    cmd=' && '.join([
                        'STAGE=$(mktemp -d)',
                        'cp %s/target/release/%s $STAGE/' % (BACKEND, svc['binary']),
                        'cp %s $STAGE/Dockerfile' % dockerfile,
                        'docker build -t %s $STAGE' % image_tag,
                        'kind load docker-image %s --name stoat' % image_tag,
                        'rm -rf $STAGE',
                    ]),
                    resource_deps=['backend-build'],
                    labels=['build'],
                )

        # Apply service manifests
        k8s_yaml('k8s/services/delta.yaml')
        k8s_yaml('k8s/services/bonfire.yaml')
        k8s_yaml('k8s/services/autumn.yaml')
        k8s_yaml('k8s/services/january.yaml')

        # Wire up k8s resources with port forwards and dependencies
        image_dep = lambda name: ['%s-image' % name] if not PREBUILT else []
        k8s_resource('delta', labels=['services'],
                     resource_deps=image_dep('delta') + ['redis', 'mongodb', 'minio-init', 'rabbitmq'])
        k8s_resource('bonfire', labels=['services'],
                     resource_deps=image_dep('bonfire') + ['redis', 'mongodb', 'rabbitmq'])
        k8s_resource('autumn', labels=['services'],
                     resource_deps=image_dep('autumn') + ['redis', 'mongodb', 'minio-init'])
        k8s_resource('january', labels=['services'],
                     resource_deps=image_dep('january') + ['redis', 'mongodb'])

        # Seed data — test users, servers, channels, messages
        SEED_DIR = os.path.join(os.getcwd(), 'seed')
        local_resource(
            'seed-image',
            cmd=' && '.join([
                'STAGE=$(mktemp -d)',
                'cp %s/seed.py $STAGE/' % SEED_DIR,
                'cp %s/Dockerfile.seed $STAGE/Dockerfile' % DOCKER_DIR,
                'docker build -t stoat-seed:dev $STAGE',
                'kind load docker-image stoat-seed:dev --name stoat',
                'rm -rf $STAGE',
            ]),
            deps=[SEED_DIR, os.path.join(DOCKER_DIR, 'Dockerfile.seed')],
            labels=['seed'],
        )

        k8s_yaml('k8s/seed.yaml')
        k8s_resource('seed', labels=['seed'],
                     resource_deps=['seed-image', 'delta', 'mongodb'])

# ---------------------------------------------------------------------------
# Frontend — local Vite dev server (not containerised)
# ---------------------------------------------------------------------------
if has_frontend:
    frontend_deps = ['delta'] if has_backend else []
    local_resource(
        'frontend-dev',
        serve_cmd='cd %s/packages/client && pnpm exec vite --host' % FRONTEND,
        labels=['frontend'],
        resource_deps=frontend_deps,
        links=['http://localhost:5173'],
    )

# ---------------------------------------------------------------------------
# Flutter frontend — containerised dev server (no host Flutter SDK needed)
# ---------------------------------------------------------------------------
if has_flutter:
    flutter_deps = ['delta'] if has_backend else []
    SDK_PATH = os.path.join(SIBLING_DIR, 'stoat-sdk-dart')

    # Build the flutter dev image (one-time, uses cached Flutter SDK layer)
    local_resource(
        'flutter-dev-image',
        cmd='docker build -t stoat-flutter-dev:latest -f %s/Dockerfile.flutter-dev %s' % (DOCKER_DIR, DOCKER_DIR),
        deps=[os.path.join(DOCKER_DIR, 'Dockerfile.flutter-dev')],
        labels=['build'],
    )

    local_resource(
        'flutter-dev',
        serve_cmd=' '.join([
            'docker rm -f stoat-flutter-dev 2>/dev/null;',
            'docker run --rm --name stoat-flutter-dev',
            '-p 5174:5174',
            '-v %s:/app' % FLUTTER,
            '-v %s:/stoat-sdk-dart' % SDK_PATH,
            'stoat-flutter-dev:latest',
        ]),
        labels=['frontend'],
        resource_deps=flutter_deps + ['flutter-dev-image'],
        links=['http://localhost:5174'],
    )

    # Integration tests — runs in container against the real seeded backend.
    # Uses host network to reach delta at localhost:14702.
    flutter_test_deps = ['flutter-dev-image'] + flutter_deps
    if has_backend:
        flutter_test_deps.append('seed')
    local_resource(
        'flutter-tests',
        cmd=' '.join([
            'docker run --rm --name stoat-flutter-tests',
            '--network=host',
            '-v %s:/app' % FLUTTER,
            '-v %s:/stoat-sdk-dart' % SDK_PATH,
            'stoat-flutter-dev:latest',
            'sh', '-c',
            '"flutter pub get && cd packages/app && flutter test integration_test/' +
            ' --dart-define=INTEGRATION_TEST_API_URL=http://localhost:14702' +
            ' --dart-define=INTEGRATION_TEST_WS_URL=ws://localhost:14703' +
            ' --dart-define=INTEGRATION_TEST_MEDIA_URL=http://localhost:14704"',
        ]),
        trigger_mode=TRIGGER_MODE_MANUAL,
        auto_init=False,
        labels=['test'],
        resource_deps=flutter_test_deps,
    )

# ---------------------------------------------------------------------------
# Knowledge Browser — optional Elixir/Phoenix service (disabled by default)
# ---------------------------------------------------------------------------
# Toggle via: tilt args -- --knowledge-browser
#             tilt up -- --knowledge-browser
#             Edit tilt_config.json: {"knowledge-browser": true}
#             Click Enable/Disable button in the Tilt UI
# ---------------------------------------------------------------------------

load('ext://uibutton', 'cmd_button')

ENABLE_KB = cfg.get('knowledge-browser', False)
KB_PATH = os.path.join(SIBLING_DIR, 'knowledge-browser')
has_kb = os.path.exists(os.path.join(KB_PATH, 'mix.exs'))
CONFIG_FILE = os.path.join(os.getcwd(), 'tilt_config.json')

if not ENABLE_KB:
    # --- Disabled: show placeholder with Enable button ---
    local_resource(
        '\u26a0\ufe0f knowledge-browser',
        cmd='echo "Knowledge Browser is DISABLED. Click Enable to turn it on."',
        labels=['knowledge-browser'],
    )
    cmd_button(
        'enable-knowledge-browser',
        resource='\u26a0\ufe0f knowledge-browser',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['knowledge-browser'] = True
json.dump(cfg, open(path, 'w'), indent=2)
print('Knowledge Browser enabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Enable',
        icon_name='power_settings_new',
    )

elif not has_kb:
    # --- Enabled but repo not cloned: show clone button ---
    local_resource(
        'knowledge-browser',
        cmd='echo "Knowledge Browser repo not found at %s. Clone it first."' % KB_PATH,
        labels=['knowledge-browser'],
    )
    cmd_button(
        'clone-knowledge-browser',
        resource='knowledge-browser',
        argv=['sh', '-c', 'git clone https://github.com/episkopos/knowledge-browser.git %s && echo "Cloned! Tiltfile will re-evaluate..."' % KB_PATH],
        text='Clone Repo',
        icon_name='download',
    )
    cmd_button(
        'disable-knowledge-browser',
        resource='knowledge-browser',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['knowledge-browser'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('Knowledge Browser disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )

elif not COMPOSE:
    # --- Enabled and cloned (K8s mode): deploy KB using shared module ---
    _kb = load_dynamic(KB_PATH + '/tilt_lib.star')
    _kb['kb_docker_build'](KB_PATH)
    _kb['kb_k8s_resources'](KB_PATH, variant='stoat',
                            labels=['knowledge-browser'],
                            resource_deps=['mongodb'])

    # Button to disable
    cmd_button(
        'disable-knowledge-browser',
        resource='knowledge-browser',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['knowledge-browser'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('Knowledge Browser disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )

# ---------------------------------------------------------------------------
# Discord-Stoat-Sync — optional Next.js service (disabled by default)
# ---------------------------------------------------------------------------
# Toggle via: tilt args -- --discord-stoat-sync
#             Edit tilt_config.json: {"discord-stoat-sync": true}
#             Click Enable/Disable button in the Tilt UI
# ---------------------------------------------------------------------------

ENABLE_DSS = cfg.get('discord-stoat-sync', False)
DSS_PATH = os.path.join(SIBLING_DIR, 'discord-stoat-sync')
has_dss = os.path.exists(os.path.join(DSS_PATH, 'package.json'))

if not ENABLE_DSS:
    # --- Disabled: show placeholder with Enable button ---
    local_resource(
        '\u26a0\ufe0f discord-stoat-sync',
        cmd='echo "Discord-Stoat-Sync is DISABLED. Click Enable to turn it on."',
        labels=['discord-stoat-sync'],
    )
    cmd_button(
        'enable-discord-stoat-sync',
        resource='\u26a0\ufe0f discord-stoat-sync',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['discord-stoat-sync'] = True
json.dump(cfg, open(path, 'w'), indent=2)
print('Discord-Stoat-Sync enabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Enable',
        icon_name='power_settings_new',
    )

elif not has_dss:
    # --- Enabled but repo not cloned: show clone button ---
    local_resource(
        'discord-stoat-sync',
        cmd='echo "Discord-Stoat-Sync repo not found at %s. Clone it first."' % DSS_PATH,
        labels=['discord-stoat-sync'],
    )
    cmd_button(
        'clone-discord-stoat-sync',
        resource='discord-stoat-sync',
        argv=['sh', '-c', 'git clone https://github.com/Cypherpunk-Labs/discord-stoat-sync.git %s && echo "Cloned! Tiltfile will re-evaluate..."' % DSS_PATH],
        text='Clone Repo',
        icon_name='download',
    )
    cmd_button(
        'disable-discord-stoat-sync',
        resource='discord-stoat-sync',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['discord-stoat-sync'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('Discord-Stoat-Sync disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )

elif not COMPOSE:
    # --- Enabled and cloned (K8s mode): deploy DSS using shared module ---
    _dss = load_dynamic(DSS_PATH + '/tilt_lib.star')
    _dss['dss_docker_build'](DSS_PATH)
    _dss['dss_k8s_resources'](DSS_PATH, variant='stoat',
                              labels=['discord-stoat-sync'])

    # Button to disable
    cmd_button(
        'disable-discord-stoat-sync',
        resource='discord-stoat-sync',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['discord-stoat-sync'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('Discord-Stoat-Sync disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )

# ---------------------------------------------------------------------------
# Activity Simulator — synthetic data generator (disabled by default)
# ---------------------------------------------------------------------------
# Toggle via: tilt args -- --activity-sim
#             Edit tilt_config.json: {"activity-sim": true}
#             Click Enable/Disable button in the Tilt UI
# ---------------------------------------------------------------------------

ENABLE_SIM = cfg.get('activity-sim', False)
SIM_DIR = os.path.join(os.getcwd(), 'sim')

if not ENABLE_SIM:
    local_resource(
        '\u26a0\ufe0f activity-sim',
        cmd='echo "Activity Simulator is DISABLED. Click Enable to turn it on."',
        labels=['tools'],
    )
    cmd_button(
        'enable-activity-sim',
        resource='\u26a0\ufe0f activity-sim',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['activity-sim'] = True
json.dump(cfg, open(path, 'w'), indent=2)
print('Activity Simulator enabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Enable',
        icon_name='power_settings_new',
    )

elif not COMPOSE:
    docker_build(
        'sim-app', SIM_DIR,
        dockerfile=os.path.join(SIM_DIR, 'Dockerfile.dev'),
        ignore=['.git', '__pycache__', '*.pyc', '.mypy_cache'],
        live_update=[
            sync(os.path.join(SIM_DIR, 'sim/'), '/app/sim/'),
            run('cd /app && pip install -e .', trigger=['pyproject.toml']),
        ],
    )

    k8s_yaml(os.path.join(SIM_DIR, 'k8s/deployment.yaml'))

    k8s_resource('activity-sim', labels=['tools'],
                 port_forwards=['3005:8000'],
                 resource_deps=['delta', 'mongodb'])

    cmd_button(
        'disable-activity-sim',
        resource='activity-sim',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['activity-sim'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('Activity Simulator disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )

# ---------------------------------------------------------------------------
# E2E Tests — Gherkin/Playwright cross-repo test suite (disabled by default)
# ---------------------------------------------------------------------------
# Toggle via: tilt args -- --e2e-tests
#             Edit tilt_config.json: {"e2e-tests": true}
#             Click Enable/Disable button in the Tilt UI
# ---------------------------------------------------------------------------

ENABLE_E2E = cfg.get('e2e-tests', False)
CHAT_PATH = os.path.join(SIBLING_DIR, 'chat')
has_e2e = os.path.exists(os.path.join(CHAT_PATH, 'packages/client/e2e/package.json'))

if not ENABLE_E2E:
    local_resource(
        '\u26a0\ufe0f e2e-tests',
        cmd='echo "E2E Tests are DISABLED. Click Enable to turn them on."',
        labels=['test'],
    )
    cmd_button(
        'enable-e2e-tests',
        resource='\u26a0\ufe0f e2e-tests',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['e2e-tests'] = True
json.dump(cfg, open(path, 'w'), indent=2)
print('E2E Tests enabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Enable',
        icon_name='power_settings_new',
    )

elif not has_e2e:
    local_resource(
        'e2e-tests',
        cmd='echo "Chat repo not found at %s or missing packages/client/e2e/package.json."' % CHAT_PATH,
        labels=['test'],
    )

elif not COMPOSE:
    # Build the E2E test image from the chat repo
    docker_build(
        'e2e-tests-image', CHAT_PATH,
        dockerfile=os.path.join(os.getcwd(), 'docker/Dockerfile.e2e'),
        ignore=['.git', 'node_modules', '.beads', '.claude', 'terraform',
                'stoat-*.png', '.playwright-mcp'],
        live_update=[
            fall_back_on([
                os.path.join(CHAT_PATH, 'packages/client/e2e/package.json'),
            ]),
            sync(os.path.join(CHAT_PATH, 'packages/client/e2e/features/'), '/app/features/'),
            sync(os.path.join(CHAT_PATH, 'packages/client/e2e/steps/'), '/app/steps/'),
            sync(os.path.join(CHAT_PATH, 'packages/client/e2e/fixtures/'), '/app/fixtures/'),
        ],
    )

    # E2E tests run on-demand, not as a persistent K8s deployment.
    # The DSS_BASE_URL points to the discord-stoat-sync service in the cluster.
    _e2e_deps = ['delta']
    _dss_url = 'http://localhost:3003'
    if cfg.get('discord-stoat-sync', False):
        _e2e_deps.append('discord-stoat-sync')
        _dss_url = 'http://discord-stoat-sync:3000'

    local_resource(
        'e2e-tests',
        cmd='echo "E2E tests ready. Click Run to execute."',
        labels=['test'],
        resource_deps=_e2e_deps,
    )

    # Run button — executes the tests in a container
    cmd_button(
        'run-e2e-tests',
        resource='e2e-tests',
        argv=['sh', '-c',
              'docker run --rm --network host ' +
              '-e DSS_BASE_URL=' + _dss_url + ' ' +
              'e2e-tests-image npx playwright test --reporter=list 2>&1'],
        text='Run Tests',
        icon_name='play_arrow',
    )

    cmd_button(
        'disable-e2e-tests',
        resource='e2e-tests',
        argv=['python3', '-c', """
import json, os
path = '%s'
cfg = json.load(open(path)) if os.path.exists(path) else {}
cfg['e2e-tests'] = False
json.dump(cfg, open(path, 'w'), indent=2)
print('E2E Tests disabled. Tiltfile will re-evaluate...')
""" % CONFIG_FILE],
        text='Disable',
        icon_name='power_settings_new',
    )
