# --- Docker Compose mode ---

# Start dev stack with Docker Compose (no Kind cluster needed)
up-compose:
    cd {{ justfile_directory() }} && tilt up -- --compose

# Start dev stack with Docker Compose + pre-built images
up-compose-prebuilt: pull-images
    cd {{ justfile_directory() }} && tilt up -- --compose --prebuilt

# Start dev stack with ALL services enabled (billing, postern, unveil, e2e)
up-full:
    #!/usr/bin/env bash
    set -euo pipefail
    just ensure-cluster
    cd {{ justfile_directory() }} && tilt up -- --full-stack

# Start full stack with Tilt API on Docker bridge
up-full-shared:
    #!/usr/bin/env bash
    set -euo pipefail
