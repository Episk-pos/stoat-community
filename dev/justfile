# Stoat dev stack — Tilt + Kind (or Docker Compose)
# Ports are in the 14xxx range to avoid conflicts with other dev stacks
# (Fray.run, execos, etc.) that may run concurrently on the same workstation.
#
# Two modes:
#   1. Kind/K8s (default): `just up` — full K8s cluster via Kind + Tilt
#   2. Docker Compose:     `just up-compose` — lighter, no Kind cluster needed
#      Or without Tilt:    `just compose-up` — plain docker compose

set dotenv-load := false

STOAT_BACKEND := env("STOAT_BACKEND", justfile_directory() + "/../../stoat-backend")
STOAT_FRONTEND := env("STOAT_FRONTEND", justfile_directory() + "/../../stoat-frontend")
CLUSTER := "censer"
CONTEXT := "kind-censer"

# Show available commands
default:
    @just --list

# Check prerequisites and create Kind cluster
# Note: Docker Compose mode (just up-compose / just compose-up) only requires
# docker (and tilt for up-compose). The full check below is for Kind/K8s mode.
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Checking prerequisites..."
    missing=()
    for cmd in docker kind tilt kubectl cargo pnpm; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [ ${#missing[@]} -ne 0 ]; then
        echo "Missing: ${missing[*]}"
        exit 1
    fi
    echo "All prerequisites found."
    just kind-create

# Start the dev stack (ensures cluster exists, then runs tilt up)
up:
    #!/usr/bin/env bash
    set -euo pipefail
    just ensure-cluster
    cd {{ justfile_directory() }} && tilt up

# Start dev stack with Tilt API bound to Docker bridge (accessible from sibling KinD containers)
up-shared:
    #!/usr/bin/env bash
    set -euo pipefail
    just ensure-cluster

    # Deterministic Tilt API port from context/namespace seed (avoids collisions
    # when multiple Tilt stacks run concurrently).
    SEED="{{ CONTEXT }}/censer"
    PORT_OFFSET=$(( $(echo -n "$SEED" | cksum | cut -d' ' -f1) % 50 * 20 ))
    TILT_PORT=$(( 10350 + PORT_OFFSET ))

    # Detect Docker bridge gateway for the 'kind' network.
    # Falls back to 127.0.0.1 if docker/jq unavailable or 'kind' network missing.
    BRIDGE_IP="127.0.0.1"
    if command -v jq &>/dev/null && command -v docker &>/dev/null; then
        DETECTED="$(docker network inspect kind 2>/dev/null \
            | jq -r '.[0].IPAM.Config[] | select(.Gateway != "" and (.Gateway | contains(":") | not)) | .Gateway' 2>/dev/null || true)"
        if [ -n "$DETECTED" ]; then
            BRIDGE_IP="$DETECTED"
        fi
    fi

    echo "Tilt API bound to $BRIDGE_IP:$TILT_PORT (reachable from KinD containers)"

    # Bridge the Tilt apiserver (localhost-only, random port) to the Docker bridge
    # so the tilt CLI works from inside sibling containers.
    BRIDGE_SCRIPT="{{ justfile_directory() }}/../../assistant/tools/devenv/tilt_api_bridge.sh"
    if [ -x "$BRIDGE_SCRIPT" ] && command -v socat &>/dev/null; then
        "$BRIDGE_SCRIPT" --tilt-port "$TILT_PORT" --bridge-ip "$BRIDGE_IP" &
        BRIDGE_PID=$!
        trap 'kill $BRIDGE_PID 2>/dev/null; wait $BRIDGE_PID 2>/dev/null' EXIT INT TERM
    else
        echo "(Skipping API bridge — socat or bridge script not available)"
    fi

    cd {{ justfile_directory() }} && tilt up --port "$TILT_PORT" --host "$BRIDGE_IP"

# Stop Tilt (leaves cluster intact)
down:
    cd {{ justfile_directory() }} && tilt down

# Run frontend E2E tests against the running stack
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cp {{ STOAT_FRONTEND }}/packages/client/.env.e2e {{ STOAT_FRONTEND }}/packages/client/.env
    cd {{ STOAT_FRONTEND }}
    pnpm --filter client exec vite build
    pnpm --filter client exec playwright test

# Show cluster, pods, and tilt status
status:
    @echo "=== Kind clusters ==="
    @kind get clusters 2>/dev/null || true
    @echo ""
    @echo "=== Pods in censer namespace ==="
    @kubectl --context {{ CONTEXT }} get pods -n censer 2>/dev/null || echo "(cluster not running)"
    @echo ""
    @echo "=== Tilt resources ==="
    @cd {{ justfile_directory() }} && tilt get uiresources 2>/dev/null || echo "(tilt not running)"

# Tail logs for a service
logs service:
    kubectl --context {{ CONTEXT }} logs -n censer -l app={{ service }} -f

# Create the Kind cluster
kind-create:
    #!/usr/bin/env bash
    set -euo pipefail
    if kind get clusters 2>/dev/null | grep -q "^{{ CLUSTER }}$"; then
        echo "Cluster '{{ CLUSTER }}' already exists."
    else
        kind create cluster --config {{ justfile_directory() }}/kind-config.yaml
        echo "Cluster '{{ CLUSTER }}' created."
    fi

# Ensure Kind cluster and kubeconfig context exist
ensure-cluster:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! kind get clusters 2>/dev/null | grep -q "^{{ CLUSTER }}$"; then
        just kind-create
    fi
    # Re-export kubeconfig if context is missing (e.g. after Docker restart)
    if ! kubectl config get-contexts {{ CONTEXT }} &>/dev/null; then
        echo "Context '{{ CONTEXT }}' missing — re-exporting kubeconfig..."
        kind export kubeconfig --name {{ CLUSTER }}
    fi
    kubectl config use-context {{ CONTEXT }}

# Delete the Kind cluster
kind-delete:
    kind delete cluster --name {{ CLUSTER }}

# Pull pre-built backend images from registry (skips cargo build)
pull-images tag="latest":
    {{ justfile_directory() }}/scripts/pull-images.sh {{ tag }}

# Start dev stack with pre-built images (no Rust toolchain needed)
up-prebuilt: pull-images
    #!/usr/bin/env bash
    set -euo pipefail
    just ensure-cluster
    cd {{ justfile_directory() }} && tilt up -- --prebuilt

# Start dev stack with pre-built images, Tilt API on Docker bridge
up-shared-prebuilt: pull-images
    #!/usr/bin/env bash
    set -euo pipefail
    just ensure-cluster

    SEED="{{ CONTEXT }}/censer"
    PORT_OFFSET=$(( $(echo -n "$SEED" | cksum | cut -d' ' -f1) % 50 * 20 ))
