# Local repo path overrides
# Copy to repos.env and uncomment lines to override default sibling discovery.
# repos.env is gitignored — it stays on your workstation only.
#
# Default: repos are resolved as siblings of stoat-community's parent directory.
# Example: if stoat-community is at ~/Projects/stoat-community,
#          stoat-backend defaults to ~/Projects/stoat-backend
#
# STOAT_BACKEND=/path/to/stoat-backend
# STOAT_FRONTEND=/path/to/stoat-frontend
# STOAT_FLUTTER=/path/to/stoat-flutter
# STOAT_SDK_DART=/path/to/stoat-sdk-dart
# DSS_PATH=/path/to/discord-stoat-sync
# KB_PATH=/path/to/knowledge-browser
# CHAT_PATH=/path/to/chat
# COMMUNITY_PATH=/path/to/stoat-community
